{
  "name": "hnx",
  "private": true,
  "description": "Privacy-first Hacker News reader",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.cjs",
    "vendor:sync": "node scripts/vendor.cjs",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run test:browser"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.17",
    "ipaddr.js": "2.5.0",
    "jsdom": "29.1.1",
    "sanitize-html": "2.18.1",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
