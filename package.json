    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "dompurify": "3.4.17"
  }
}
